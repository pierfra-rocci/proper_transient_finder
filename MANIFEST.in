include pyproject.toml README.md USER_GUIDE.md LICENSE run_proper_transient_finder.py mkdocs.yml
include .gitattributes .github/workflows/proper-transient-finder.yml
include .github/instructions/proper-transient-finder.instructions.md
recursive-include src *.py py.typed
recursive-include tests *.py
recursive-include experiments *.py
recursive-include scripts *.ps1 *.sh *.py
recursive-include docs *.md
prune artifacts
prune build
prune dist
prune site
prune .venv
global-exclude *.py[cod]